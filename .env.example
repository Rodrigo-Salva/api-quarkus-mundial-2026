# ═══════════════════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — Mundial 2026 Predictions API
#
#  1. Copia este archivo: cp .env.example .env
#  2. Rellena los valores reales
#  3. NUNCA subas .env al repositorio
#
#  DESARROLLO LOCAL: los valores por defecto funcionan sin cambios.
#  PRODUCCIÓN AWS:   reemplaza los valores con los de AWS.
# ═══════════════════════════════════════════════════════════════

# ╔══════════════════════════════════════════════════════════════╗
# ║  DESARROLLO LOCAL (docker-compose incluido)                 ║
# ╚══════════════════════════════════════════════════════════════╝

# ── PostgreSQL ────────────────────────────────────────────────
DB_USER=mundial_user
DB_PASSWORD=PON_TU_PASSWORD_AQUI
DB_URL=jdbc:postgresql://localhost:5433/mundial2026
DB_URL_TEST=jdbc:postgresql://localhost:5433/mundial2026_test

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── DynamoDB Local ────────────────────────────────────────────
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000

# ── Storage S3 (MinIO local — ya incluido en docker-compose) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=PON_TU_ACCESS_KEY
S3_SECRET_KEY=PON_TU_SECRET_KEY
S3_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1

# ── IA (opcional — pon la API key del proveedor que uses) ─────
# Opciones: gemini | chatgpt | claude | grok
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_CHATGPT_API_KEY=
AI_CLAUDE_API_KEY=
AI_GROK_API_KEY=

# ── CORS + Frontend ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000


# ╔══════════════════════════════════════════════════════════════╗
# ║  PRODUCCIÓN AWS                                             ║
# ║  Reemplaza los valores de arriba con estos                  ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Amazon RDS — PostgreSQL ───────────────────────────────────
# Crea en: AWS Console → RDS → Create database → PostgreSQL 16
#
# DB_USER=mundial_user
# DB_PASSWORD=PASSWORD_MUY_SEGURO_AQUI
# DB_URL=jdbc:postgresql://mundial2026.xxxxxxx.us-east-1.rds.amazonaws.com:5432/mundial2026

# ── Amazon ElastiCache — Redis ────────────────────────────────
# Crea en: AWS Console → ElastiCache → Create → Redis OSS
#
# REDIS_HOST=mundial2026.xxxxxx.cache.amazonaws.com
# REDIS_PORT=6379

# ── Amazon MSK — Kafka ────────────────────────────────────────
# Crea en: AWS Console → MSK → Create cluster
# O usa Confluent Cloud (más fácil)
#
# KAFKA_BROKERS=b-1.mundial2026.xxxxxx.kafka.us-east-1.amazonaws.com:9092

# ── Amazon DynamoDB ───────────────────────────────────────────
# NO necesitas crear servidor — DynamoDB es serverless.
# Las tablas se crean automáticamente al arrancar la API.
# Solo necesitas credenciales IAM con permisos DynamoDB.
#
# AWS_REGION=us-east-1
# DYNAMODB_ENDPOINT=          ← dejar VACÍO para usar AWS real
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Amazon S3 ─────────────────────────────────────────────────
# Crea en: AWS Console → S3 → Create bucket
# Crea 3 buckets: mundial-avatars, mundial-leagues, mundial-exports
#
# S3_ENDPOINT=               ← dejar VACÍO para usar AWS real
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_PATH_STYLE=false
# S3_PUBLIC_URL=https://mundial-avatars.s3.amazonaws.com
# S3_REGION=us-east-1

# ── CORS producción ───────────────────────────────────────────
# CORS_ORIGINS=https://tu-dominio.com
# FRONTEND_URL=https://tu-dominio.com

# ── Usuario IAM recomendado (permisos mínimos) ────────────────
# Crea un usuario IAM con solo estas políticas:
#   - AmazonDynamoDBFullAccess  (para crear/leer tablas)
#   - AmazonS3FullAccess        (para subir/borrar archivos)
# NO uses las credenciales root de AWS.
