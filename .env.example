# ═══════════════════════════════════════════════════════════════
#  VARIABLES DE ENTORNO — Mundial 2026 Predictions API
#
#  PASOS:
#  1. Copia este archivo: cp .env.example .env
#  2. Rellena SOLO las 3 variables marcadas con ← CAMBIA
#  3. El resto funciona por defecto en desarrollo local
#  4. NUNCA subas .env al repositorio
# ═══════════════════════════════════════════════════════════════

# ╔══════════════════════════════════════════════════════════════╗
# ║  LO ÚNICO QUE DEBES CAMBIAR (3 valores)                     ║
# ╚══════════════════════════════════════════════════════════════╝
DB_PASSWORD=PON_TU_PASSWORD_AQUI          # ← CAMBIA
S3_ACCESS_KEY=PON_TU_ACCESS_KEY           # ← CAMBIA (inventalo: mi_minio_key)
S3_SECRET_KEY=PON_TU_SECRET_KEY           # ← CAMBIA (inventalo: mi_minio_secret)

# ╔══════════════════════════════════════════════════════════════╗
# ║  ESTO NO LO TOQUES — funciona automáticamente               ║
# ╚══════════════════════════════════════════════════════════════╝

# Base de datos
DB_USER=mundial_user
DB_URL=jdbc:postgresql://localhost:5433/mundial2026
DB_URL_TEST=jdbc:postgresql://localhost:5433/mundial2026_test
POSTGRES_DB=mundial2026

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# DynamoDB Local
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000

# Storage MinIO (local)
S3_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1

# IA — déjalo vacío si no tienes API key, la app funciona igual
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=not-configured
AI_CHATGPT_API_KEY=not-configured
AI_CLAUDE_API_KEY=not-configured
AI_GROK_API_KEY=not-configured

# Frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Docker image (no tocar)
DOCKER_IMAGE=mundial2026-api:latest

# ╔══════════════════════════════════════════════════════════════╗
